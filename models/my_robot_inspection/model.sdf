<sdf version="1.8">
  <model name="my_robot_inspection">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0.16 0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.15</ixx>
          <iyy>0.28</iyy>
          <izz>0.37</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.56 0.42 0.18</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.56 0.42 0.18</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.36 0.58 1</ambient>
          <diffuse>0.08 0.46 0.72 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <visual name="top_panel_visual">
        <pose>0 0 0.105 0 0 0</pose>
        <geometry>
          <box>
            <size>0.44 0.30 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.08 0.10 1</ambient>
          <diffuse>0.04 0.10 0.12 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.245 0.075 -1.5708 0 0</pose>
      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.0012</ixx>
          <iyy>0.0012</iyy>
          <izz>0.0020</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.245 0.075 -1.5708 0 0</pose>
      <inertial>
        <mass>0.7</mass>
        <inertia>
          <ixx>0.0012</ixx>
          <iyy>0.0012</iyy>
          <izz>0.0020</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.03 0.03 0.03 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="front_castor">
      <pose>0.23 0 0.035 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.035</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.035</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rear_castor">
      <pose>-0.23 0 0.035 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.035</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.035</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.55 0.55 0.55 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="lidar_link">
      <pose>0.20 0 0.32 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0.62 0 1</ambient>
          <diffuse>1 0.62 0 1</diffuse>
          <emissive>0.4 0.18 0 1</emissive>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <always_on>true</always_on>
        <topic>/scan</topic>
      </sensor>
    </link>

    <link name="visibility_marker">
      <pose>-0.16 0 0.78 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <visual name="marker_pole">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>1.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <emissive>0.5 0 0 1</emissive>
        </material>
      </visual>
      <visual name="marker_flag">
        <pose>0.18 0 0.38 0 0 0</pose>
        <geometry>
          <box>
            <size>0.36 0.05 0.24</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 0 1</ambient>
          <diffuse>1 1 0 1</diffuse>
          <emissive>0.6 0.6 0 1</emissive>
        </material>
      </visual>
      <visual name="marker_beacon">
        <pose>0 0 0.62 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.10</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1 0.35 0 1</ambient>
          <diffuse>1 0.35 0 1</diffuse>
          <emissive>0.8 0.2 0 1</emissive>
        </material>
      </visual>
    </link>


    <link name="front_camera_link">
      <pose>0.24 0 0.52 0 0 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00008</ixx>
          <iyy>0.00008</iyy>
          <izz>0.00008</izz>
        </inertia>
      </inertial>
      <visual name="camera_body_visual">
        <geometry><box><size>0.10 0.08 0.07</size></box></geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <visual name="camera_lens_visual">
        <pose>0.055 0 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.018</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.08 0.16 1</ambient>
          <diffuse>0.03 0.16 0.30 1</diffuse>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <pose>0.06 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/inspection/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>20.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <effort>30</effort>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <effort>30</effort>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="front_castor_joint" type="ball">
      <parent>base_link</parent>
      <child>front_castor</child>
    </joint>

    <joint name="rear_castor_joint" type="ball">
      <parent>base_link</parent>
      <child>rear_castor</child>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <joint name="visibility_marker_joint" type="fixed">
      <parent>base_link</parent>
      <child>visibility_marker</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.49</wheel_separation>
      <wheel_radius>0.075</wheel_radius>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <max_wheel_torque>30.0</max_wheel_torque>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
      <tf_topic>/tf</tf_topic>
    </plugin>
  </model>
</sdf>

