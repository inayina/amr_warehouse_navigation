<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mm_parallel_gripper" params="parent">
    <link name="gripper_base_link">
      <visual>
        <geometry><box size="0.10 0.12 0.08"/></geometry>
        <material name="mm_dark"><color rgba="0.15 0.15 0.18 1.0"/></material>
      </visual>
      <collision><geometry><box size="0.10 0.12 0.08"/></geometry></collision>
      <inertial><mass value="0.70"/><origin xyz="0 0 0"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
    </link>
    <joint name="flange_to_gripper" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_base_link"/>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </joint>

    <link name="left_finger_link">
      <visual><origin xyz="0 0.025 0.07"/><geometry><box size="0.025 0.025 0.14"/></geometry><material name="mm_orange"><color rgba="0.90 0.35 0.05 1.0"/></material></visual>
      <collision><origin xyz="0 0.025 0.07"/><geometry><box size="0.025 0.025 0.14"/></geometry></collision>
      <inertial><mass value="0.10"/><origin xyz="0 0.025 0.07"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
    </link>
    <joint name="mm_left_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="left_finger_link"/>
      <origin xyz="0 0.035 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.04" effort="40" velocity="0.10"/>
    </joint>

    <link name="right_finger_link">
      <visual><origin xyz="0 -0.025 0.07"/><geometry><box size="0.025 0.025 0.14"/></geometry><material name="mm_orange"/></visual>
      <collision><origin xyz="0 -0.025 0.07"/><geometry><box size="0.025 0.025 0.14"/></geometry></collision>
      <inertial><mass value="0.10"/><origin xyz="0 -0.025 0.07"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
    </link>
    <joint name="mm_right_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="right_finger_link"/>
      <origin xyz="0 -0.035 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.04" effort="40" velocity="0.10"/>
      <mimic joint="mm_left_finger_joint" multiplier="1" offset="0"/>
    </joint>

    <link name="mm_tcp"/>
    <joint name="gripper_to_mm_tcp" type="fixed">
      <parent link="gripper_base_link"/>
      <child link="mm_tcp"/>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
    </joint>
    <link name="camera_link">
      <visual><geometry><box size="0.045 0.045 0.035"/></geometry><material name="mm_black"><color rgba="0.02 0.02 0.02 1.0"/></material></visual>
      <collision><geometry><box size="0.045 0.045 0.035"/></geometry></collision>
      <inertial><mass value="0.05"/><origin xyz="0 0 0"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
    </link>
    <joint name="mm_tcp_to_camera" type="fixed">
      <parent link="mm_tcp"/>
      <child link="camera_link"/>
      <origin xyz="0.04 0 0.02" rpy="0 0 0"/>
    </joint>
    <link name="camera_optical_frame"/>
    <joint name="camera_to_optical" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>
  </xacro:macro>
</robot>
